<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Glyph Matrix を使う -->
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />
    <!-- バッテリー最適化の対象外のときだけ、表示中に CPU を起こしておく（Doze 中は、対象外でないと WakeLock が効かない） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- MARBLE が縁に当たったとき -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- vwfndr を開いている間だけアイコンを出すため、前面のアプリを調べる（「使用状況へのアクセス」で許可する） -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- システムの Glyph の設定画面を開くため（Android 11 以降のパッケージの見え方の制限） -->
    <queries>
        <package android:name="com.nothing.thirdparty" />
        <intent>
            <action android:name="android.settings.ACTION_GLYPHS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
    </queries>

    <application
        android:name=".DotPopArtApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.DotPopArt">

        <meta-data
            android:name="NothingKey"
            android:value="test" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Glyph Toy「Dot=PopArt」（1つだけ登録し、中でおもちゃを切り替える） -->
        <service
            android:name=".glyph.DotPopArtToyService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>
            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/toy_name" />
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/img_toy_preview" />
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/toy_summary" />
            <meta-data
                android:name="com.nothing.glyph.toy.introduction"
                android:value="com.dotpopart.app.MainActivity" />
            <!-- (4a) Pro は AOD のおもちゃだけ使える -->
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1" />
            <!-- Phone (3) の Glyph ボタン長押し -->
            <meta-data
                android:name="com.nothing.glyph.toy.longpress"
                android:value="1" />
        </service>

        <!-- AQUARIUM：通知が来たという事実だけを数える（中身は読まない） -->
        <service
            android:name=".glyph.NotificationCounter"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
